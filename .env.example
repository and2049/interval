INTERVAL_OPENF1_LIVE_ENABLED=true

# The OpenF1 token is normally set from the desktop app's settings panel, which stores it
# in the per-user config directory. Uncomment this only to supply it from the environment
# instead; a token saved in the settings panel takes precedence over this value.
# INTERVAL_OPENF1_LIVE_TOKEN=YOUR_OPENF1_SPONSOR_TOKEN

# Historical downloads need a Formula 1 account with an F1 TV subscription (an Apple TV
# subscription must be linked to a Formula 1 account first). The desktop app's settings
# panel stores this login too; set these only for headless or `cargo run` backends.
# A login saved in the settings panel takes precedence over these values.
# F1_USERNAME=you@example.com
# F1_PASSWORD=your-formula1-account-password

# Optional:
# INTERVAL_OPENF1_LIVE_BASE_URL=https://api.openf1.org/v1/
# INTERVAL_OPENF1_LIVE_AUTH_HEADER=Authorization
